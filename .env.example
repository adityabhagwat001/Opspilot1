# ==========================================
# OPSPILOT ENTERPRISE CONFIGURATION
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=opspilot_super_secret_enterprise_jwt_key_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite dev fallback)
DATABASE_URL=sqlite+aiosqlite:///./opspilot.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_password@localhost:5432/opspilot_db

# Operations Database (Target DB accessed by Postgres MCP server)
OPS_DATABASE_URL=sqlite+aiosqlite:///./operational_data.db
# For production company PostgreSQL:
# OPS_DATABASE_URL=postgresql+asyncpg://ops_user:ops_password@localhost:5432/operations_db

# AI Provider Configuration (LangGraph Agent)
# Supports OpenRouter, OpenAI, Anthropic, or Local Ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub Integration Configuration
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# Email & Calendar Integration Configuration (Google OAuth / Mock Enterprise Mail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
ENTERPRISE_MAIL_ADDRESS=ops@enterprise.internal

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
MCP_POSTGRES_PORT=8001
MCP_GITHUB_PORT=8002
MCP_PRODUCTIVITY_PORT=8003
