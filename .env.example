# ==========================================
# OPSPILOT ENTERPRISE CONFIGURATION
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
# High-entropy JWT signing secret key (minimum 32 characters)
SECRET_KEY=opspilot_super_secret_enterprise_jwt_key_change_in_production_32chars
# Nonced HMAC-SHA256 human approval secret key (minimum 32 characters)
OPSPILOT_APPROVAL_SECRET=opspilot_trusted_approval_boundary_secret_key_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Internal System Database)
# Development fallback:
DATABASE_URL=sqlite+aiosqlite:///./opspilot_system.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_password@localhost:5432/opspilot_db

# Operations Database (Target DB accessed by Postgres MCP server)
# Development fallback:
# OPS_DATABASE_URL=sqlite+aiosqlite:///./operational_data.db
# For production / cloud PostgreSQL (e.g. Neon, AWS RDS):
OPS_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<database>?ssl=require

# AI Provider Configuration (LangGraph Agent)
# Options: groq | openai | anthropic | openrouter | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub Integration Configuration
# Personal Access Token with repo, workflow, read:org scopes
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_DEFAULT_OWNER=adityabhagwat001
GITHUB_DEFAULT_REPO=Opspilot1
# Optional Webhook secret for GitHub Actions / push event verification
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# Email (SMTP) & Calendar Integration Configuration
ENTERPRISE_MAIL_ADDRESS=ops@enterprise.internal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
MCP_POSTGRES_PORT=8001
MCP_GITHUB_PORT=8002
MCP_PRODUCTIVITY_PORT=8003
