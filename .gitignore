# ==============================================================================
# OpsPilot Project Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
secrets.yaml

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# IDEs & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Database & Telemetry Local Dumps
*.sqlite
*.sqlite3
*.db
backend/data/*.db

# Logs
logs/
*.log
npm-debug.log*

# Docker
.dockerignore
